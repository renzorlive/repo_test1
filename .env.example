# ----------------------------------------------------------------------------
# RNZ OS — Environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://rnz:rnz@localhost:5432/rnz_os?schema=public"

# Auth.js / NextAuth — generate with: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-strong-random-secret"

# Public base URL of the app (used by Auth.js callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Redis connection for BullMQ (prepared, not yet active).
REDIS_URL="redis://localhost:6379"

# Application runtime environment.
NODE_ENV="development"
