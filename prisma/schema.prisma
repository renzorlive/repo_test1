// ============================================================================
// RNZ OS — Prisma schema
// An AI Operating System for founders, agencies and AI-assisted development.
//
// Design notes:
//  - Multi-tenant by Workspace. Every domain entity is scoped to a workspace.
//  - Users join workspaces through Membership (many-to-many + role).
//  - Execution hierarchy: Project > Mission > Epic > Task.
//  - Agent / Workflow / Decision / Artifact model the AI-execution layer.
//  - NextAuth/Auth.js tables (Account, Session, VerificationToken) included.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MissionStatus {
  DRAFT
  ACTIVE
  BLOCKED
  COMPLETED
  CANCELLED
}

enum EpicStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AgentType {
  ORCHESTRATOR
  RESEARCHER
  ENGINEER
  WRITER
  ANALYST
  REVIEWER
  CUSTOM
}

enum AgentStatus {
  IDLE
  RUNNING
  PAUSED
  ERROR
  DISABLED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DecisionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum ArtifactType {
  DOCUMENT
  CODE
  DESIGN
  DATASET
  REPORT
  LINK
  OTHER
}

// ---- Mission Engine enums ---------------------------------------------------

/// Operational health of a mission, distinct from its lifecycle status.
enum MissionHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  BLOCKED
  UNKNOWN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// Who or what produced an activity / acted on a mission.
enum ActorType {
  USER
  AGENT
  SYSTEM
}

/// Append-only event taxonomy for the mission activity timeline.
enum ActivityType {
  MISSION_CREATED
  MISSION_UPDATED
  MISSION_STATUS_CHANGED
  MISSION_HEALTH_CHANGED
  MISSION_COMPLETED
  EPIC_CREATED
  TASK_CREATED
  TASK_COMPLETED
  DECISION_ADDED
  ARTIFACT_UPLOADED
  AI_SESSION_STARTED
  AI_SESSION_COMPLETED
  AI_SESSION_FAILED
  APPROVAL_REQUESTED
  APPROVAL_ACCEPTED
  APPROVAL_REJECTED
  APPROVAL_CHANGES_REQUESTED
  REVIEW_FAILED
  NOTE_ADDED
  DEPENDENCY_ADDED
  METRIC_RECORDED
  EXECUTION_STARTED
  EXECUTION_COMPLETED
}

enum AiSessionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  RELATES_TO
}

enum TimelineStatus {
  PLANNED
  ACTIVE
  DONE
  SKIPPED
}

// ---- Autonomous Mission enums -----------------------------------------------

/// How much complexity the UI shows. Founder hides everything; Advanced exposes
/// every execution detail.
enum MissionMode {
  FOUNDER
  ADVANCED
}

/// How much the Mission Brain does without asking.
enum MissionAutonomy {
  MANUAL // user drives every step
  SUPERVISED // brain runs, pauses at approval gates
  AUTONOMOUS // brain runs end to end (still records approvals)
}

enum MissionPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

/// The autonomous pipeline a Mission Brain drives a goal through.
enum MissionStageType {
  PLANNING
  ARCHITECTURE
  TASK_BREAKDOWN
  WORKER_ASSIGNMENT
  EXECUTION
  REVIEW
  FIX
  COMMIT
  DEPLOY
  RELEASE_NOTES
  DONE
}

enum MissionStageStatus {
  PENDING
  ACTIVE
  WAITING_APPROVAL
  COMPLETED
  FAILED
  SKIPPED
}

// ---- AI Orchestrator enums --------------------------------------------------

enum AiProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  OLLAMA
  OPENROUTER
  LOCAL
  CUSTOM
}

/// Lifecycle status of a worker in the registry.
enum AiWorkerStatus {
  ACTIVE
  IDLE
  BUSY
  DRAINING
  DISABLED
  ERROR
}

enum AiWorkerHealth {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

/// Capability taxonomy a worker/model can advertise and an execution requires.
enum AiCapabilityKind {
  TEXT_GENERATION
  CODE_GENERATION
  REASONING
  VISION
  EMBEDDING
  FUNCTION_CALLING
  WEB_SEARCH
  STRUCTURED_OUTPUT
  SUMMARIZATION
  CLASSIFICATION
}

/// The generic execution state machine. Every transition is timestamped on the
/// AiExecution row and emitted as an AiExecutionEvent.
enum AiExecutionState {
  QUEUED
  PREPARING
  BUILDING_CONTEXT
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

enum AiExecutionEventType {
  QUEUED
  STARTED
  CONTEXT_READY
  PROMPT_GENERATED
  PROVIDER_SELECTED
  RUNNING
  WAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
  RETRY_SCHEDULED
}

enum AiQueueStatus {
  ACTIVE
  PAUSED
  DRAINING
}

enum AiLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ---- Runtime Layer enums ----------------------------------------------------

/// The kind of remote worker a runtime speaks to. Claude Code is Runtime #1;
/// the rest are placeholders the abstraction already supports.
enum RuntimeType {
  CLAUDE_CODE
  CODEX_CLI
  GEMINI_CLI
  CURSOR_CLI
  LOCAL_AGENT
  DOCKER
  SSH
}

enum RuntimeStatus {
  OFFLINE
  CONNECTING
  ONLINE
  BUSY
  DRAINING
  ERROR
}

enum HostStatus {
  OFFLINE
  ONLINE
  BUSY
  UNREACHABLE
}

enum RuntimeSessionStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  EXPIRED
}

/// Generic job lifecycle — no mission vocabulary. A runtime only ever runs jobs.
enum RuntimeExecutionStatus {
  PENDING
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum RuntimeCapabilityKind {
  SHELL
  FILE_SYSTEM
  GIT
  CODE_EXECUTION
  BROWSER
  DOCKER
  GPU
  NETWORK
}

enum RuntimeLogStream {
  STDOUT
  STDERR
  SYSTEM
}

enum RuntimeArtifactChange {
  CREATED
  MODIFIED
  DELETED
}

enum RuntimeArtifactKind {
  FILE
  TEST_REPORT
  LOG
  DIFF
  OTHER
}

enum RuntimeTerminalStatus {
  OPEN
  CLOSED
}

// ----------------------------------------------------------------------------
// Identity & tenancy
// ----------------------------------------------------------------------------

model Workspace {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  imageUrl String?
  // Free-form JSON settings (theme, feature flags, billing tier, etc.).
  settings Json    @default("{}")

  memberships Membership[]
  projects    Project[]
  missions    Mission[]
  agents      Agent[]
  workflows   Workflow[]

  // AI Orchestrator
  aiProviders    AiProvider[]
  aiCapabilities AiCapability[]
  aiWorkers      AiWorker[]
  aiQueues       AiQueue[]
  aiExecutions   AiExecution[]
  aiCosts        AiCost[]
  aiUsages       AiUsage[]

  // Runtime Layer
  runtimeHosts        RuntimeHost[]
  runtimes            Runtime[]
  runtimeCapabilities RuntimeCapability[]
  runtimeCommands     RuntimeCommand[]
  runtimeExecutions   RuntimeExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("workspaces")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  // Hashed password for the credentials provider (nullable for OAuth users).
  passwordHash  String?   @map("password_hash")

  memberships       Membership[]
  accounts          Account[]
  sessions          Session[]
  assignedTasks     Task[]       @relation("TaskAssignee")
  authoredDecisions Decision[]   @relation("DecisionAuthor")

  // Mission Engine relations
  ownedMissions      Mission[]         @relation("MissionOwner")
  missionNotes       MissionNote[]
  missionActivities  MissionActivity[] @relation("ActivityActor")
  approvalsRequested MissionApproval[] @relation("ApprovalRequester")
  approvalsReviewed  MissionApproval[] @relation("ApprovalReviewer")
  aiExecutions       AiExecution[]     @relation("ExecutionRequester")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Membership {
  id          String @id @default(cuid())
  role        Role   @default(MEMBER)
  userId      String @map("user_id")
  workspaceId String @map("workspace_id")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

// ----------------------------------------------------------------------------
// Execution hierarchy: Project > Mission > Epic > Task
// ----------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  name        String
  key         String // short uppercase code, e.g. "RNZ", unique per workspace
  description String?
  status      ProjectStatus @default(PLANNING)
  color       String?
  workspaceId String        @map("workspace_id")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  missions     Mission[]
  epics        Epic[]
  tasks        Task[]
  decisions    Decision[]
  artifacts    Artifact[]
  aiExecutions AiExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("projects")
}

/// The Mission is the central domain object of RNZ OS. Every execution
/// entity (epics, tasks, AI sessions, decisions, artifacts, approvals,
/// metrics, dependencies and activity) hangs off a mission. `workspaceId` is
/// denormalized from the parent project so workspace-scoped dashboards stay a
/// single indexed read at scale.
model Mission {
  id        String  @id @default(cuid())
  title     String
  summary   String?
  objective String? // the business objective this mission exists to achieve
  outcome   String? // the realized result, filled as the mission completes

  status   MissionStatus @default(DRAFT)
  health   MissionHealth @default(UNKNOWN)
  priority Priority      @default(MEDIUM)
  progress Int           @default(0) // 0-100 rollup derived from tasks

  // Autonomous Mission: the brain's operating mode + autonomy level.
  mode     MissionMode     @default(FOUNDER)
  autonomy MissionAutonomy @default(SUPERVISED)

  // Time & cost envelope — the basis for execution analytics.
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  dueDate        DateTime? @map("due_date")
  estimatedHours Float?    @map("estimated_hours")
  actualHours    Float?    @map("actual_hours")
  estimatedCost  Float?    @map("estimated_cost")
  actualCost     Float?    @map("actual_cost")

  projectId   String  @map("project_id")
  workspaceId String  @map("workspace_id")
  ownerId     String? @map("owner_id")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("MissionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Execution graph — everything belongs to the mission.
  epics        Epic[]
  tasks        Task[]
  decisions    Decision[]
  artifacts    Artifact[]
  context      MissionContext?
  milestones   MissionTimeline[]
  approvals    MissionApproval[]
  metrics      MissionMetric[]
  notes        MissionNote[]
  aiSessions   AiSession[]
  executions   MissionExecution[]
  activities   MissionActivity[]
  dependencies MissionDependency[] @relation("MissionDependent")
  dependents   MissionDependency[] @relation("MissionDependency")
  aiExecutions AiExecution[]
  plan         MissionPlan?
  stages       MissionStage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([workspaceId])
  @@index([status])
  @@index([health])
  @@index([ownerId])
  @@index([workspaceId, status])
  @@map("missions")
}

/// The autonomous execution plan a Mission Brain owns. One per mission; the
/// brain drives `stages` from a single business objective to "Done".
model MissionPlan {
  id           String            @id @default(cuid())
  missionId    String            @unique @map("mission_id")
  objective    String
  status       MissionPlanStatus @default(DRAFT)
  currentStage MissionStageType? @map("current_stage")
  summary      String?
  // The brain's working memory (rolling notes the manager keeps).
  memory       Json              @default("{}")

  mission Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stages  MissionStage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mission_plans")
}

/// One step in the autonomous pipeline. The brain advances stages, pausing at
/// the ones that require human approval.
model MissionStage {
  id               String             @id @default(cuid())
  planId           String             @map("plan_id")
  missionId        String             @map("mission_id")
  type             MissionStageType
  title            String
  description      String?
  status           MissionStageStatus @default(PENDING)
  position         Int                @default(0)
  requiresApproval Boolean            @default(false) @map("requires_approval")
  // What the stage produced (summary, created ids, execution id, etc.).
  output           Json               @default("{}")
  startedAt        DateTime?          @map("started_at")
  completedAt      DateTime?          @map("completed_at")

  plan    MissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  mission Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([planId, position])
  @@index([missionId])
  @@map("mission_stages")
}

model Epic {
  id        String     @id @default(cuid())
  title     String
  summary   String?
  status    EpicStatus @default(BACKLOG)
  projectId String     @map("project_id")
  missionId String?    @map("mission_id")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  tasks   Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([missionId])
  @@map("epics")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  position    Int        @default(0) // for ordering within a column
  projectId   String     @map("project_id")
  missionId   String?    @map("mission_id")
  epicId      String?    @map("epic_id")
  assigneeId  String?    @map("assignee_id")
  // An agent may own/execute a task (AI-assisted execution).
  agentId     String?    @map("agent_id")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mission      Mission?      @relation(fields: [missionId], references: [id], onDelete: SetNull)
  epic         Epic?         @relation(fields: [epicId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  artifacts    Artifact[]
  aiExecutions AiExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([missionId])
  @@index([epicId])
  @@index([status])
  @@map("tasks")
}

// ----------------------------------------------------------------------------
// AI execution layer: Agent > Workflow / Decision / Artifact
// ----------------------------------------------------------------------------

model Agent {
  id           String      @id @default(cuid())
  name         String
  description  String?
  type         AgentType   @default(CUSTOM)
  status       AgentStatus @default(IDLE)
  // System prompt / role definition (no live AI yet — stored only).
  instructions String?
  // Model + tool configuration as JSON (provider-agnostic placeholder).
  config       Json        @default("{}")
  avatarUrl    String?     @map("avatar_url")
  workspaceId  String      @map("workspace_id")

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks      Task[]
  workflows  Workflow[]
  aiSessions AiSession[]
  executions MissionExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("agents")
}

model Workflow {
  id           String         @id @default(cuid())
  name         String
  description  String?
  status       WorkflowStatus @default(DRAFT)
  // Declarative step graph (nodes/edges) stored as JSON.
  definition   Json           @default("{}")
  workspaceId  String         @map("workspace_id")
  ownerAgentId String?        @map("owner_agent_id")

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerAgent Agent?             @relation(fields: [ownerAgentId], references: [id], onDelete: SetNull)
  executions MissionExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("workflows")
}

model Decision {
  id        String         @id @default(cuid())
  title     String
  context   String?
  outcome   String?
  status    DecisionStatus @default(PROPOSED)
  projectId String         @map("project_id")
  missionId String?        @map("mission_id")
  authorId  String?        @map("author_id")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  author  User?    @relation("DecisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([missionId])
  @@map("decisions")
}

model Artifact {
  id        String       @id @default(cuid())
  name      String
  type      ArtifactType @default(DOCUMENT)
  url       String?
  // Inline content or metadata payload.
  content   Json         @default("{}")
  projectId String       @map("project_id")
  missionId String?      @map("mission_id")
  taskId    String?      @map("task_id")
  sessionId String?      @map("session_id")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mission Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  task    Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  session AiSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([missionId])
  @@index([taskId])
  @@map("artifacts")
}

// ----------------------------------------------------------------------------
// Mission Engine — execution entities (all owned by a Mission)
// ----------------------------------------------------------------------------

/// 1:1 working context for a mission: the brief the engine and agents reason
/// over. Structured fields are JSON arrays so they can evolve without schema
/// churn.
model MissionContext {
  id          String  @id @default(cuid())
  missionId   String  @unique @map("mission_id")
  background  String?
  constraints Json    @default("[]")
  assumptions Json    @default("[]")
  references  Json    @default("[]")
  metadata    Json    @default("{}")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mission_contexts")
}

/// Planned phases / milestones of a mission (the "Timeline" plan, distinct
/// from the append-only activity feed).
model MissionTimeline {
  id          String         @id @default(cuid())
  missionId   String         @map("mission_id")
  title       String
  description String?
  status      TimelineStatus @default(PLANNED)
  position    Int            @default(0)
  startsAt    DateTime?      @map("starts_at")
  endsAt      DateTime?      @map("ends_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([missionId])
  @@map("mission_timelines")
}

/// Human approval gate. Drives the approval lifecycle and emits activity on
/// every transition.
model MissionApproval {
  id            String         @id @default(cuid())
  missionId     String         @map("mission_id")
  title         String
  description   String?
  status        ApprovalStatus @default(PENDING)
  comment       String?
  // Optional subject the approval is about (e.g. ARTIFACT, DECISION, EXECUTION).
  subjectType   String?        @map("subject_type")
  subjectId     String?        @map("subject_id")
  requestedById String?        @map("requested_by_id")
  reviewerId    String?        @map("reviewer_id")
  decidedAt     DateTime?      @map("decided_at")

  mission     Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewer    User?   @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([missionId])
  @@index([status])
  @@map("mission_approvals")
}

/// Time-series metric sample for a mission (progress, burn, quality, cost…).
/// Append rows for history; query latest per key for the current value.
model MissionMetric {
  id         String   @id @default(cuid())
  missionId  String   @map("mission_id")
  key        String // machine key, e.g. "velocity", "cost_burn"
  label      String
  value      Float
  unit       String?
  target     Float?
  recordedAt DateTime @default(now()) @map("recorded_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, key])
  @@index([missionId, recordedAt])
  @@map("mission_metrics")
}

model MissionNote {
  id        String  @id @default(cuid())
  missionId String  @map("mission_id")
  authorId  String? @map("author_id")
  body      String
  pinned    Boolean @default(false)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([missionId])
  @@map("mission_notes")
}

/// Directed dependency between two missions. `mission` depends on `dependsOn`.
model MissionDependency {
  id          String         @id @default(cuid())
  missionId   String         @map("mission_id")
  dependsOnId String         @map("depends_on_id")
  type        DependencyType @default(BLOCKED_BY)
  note        String?

  mission   Mission @relation("MissionDependent", fields: [missionId], references: [id], onDelete: Cascade)
  dependsOn Mission @relation("MissionDependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([missionId, dependsOnId])
  @@index([missionId])
  @@index([dependsOnId])
  @@map("mission_dependencies")
}

/// A single AI working session against a mission. Carries token + cost
/// accounting so the platform can aggregate spend across millions of events.
model AiSession {
  id           String          @id @default(cuid())
  missionId    String          @map("mission_id")
  agentId      String?         @map("agent_id")
  title        String
  status       AiSessionStatus @default(QUEUED)
  model        String?
  summary      String?
  inputTokens  Int             @default(0) @map("input_tokens")
  outputTokens Int             @default(0) @map("output_tokens")
  cost         Float           @default(0)
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")

  mission   Mission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  artifacts Artifact[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([missionId])
  @@index([status])
  @@map("ai_sessions")
}

/// An orchestration run of the mission engine — the unit that future BullMQ
/// workers will pick up. Inputs/outputs are JSON so the contract can evolve.
model MissionExecution {
  id         String          @id @default(cuid())
  missionId  String          @map("mission_id")
  agentId    String?         @map("agent_id")
  workflowId String?         @map("workflow_id")
  status     ExecutionStatus @default(PENDING)
  trigger    String? // what initiated this run (manual, schedule, dependency…)
  input      Json            @default("{}")
  output     Json            @default("{}")
  error      String?
  startedAt  DateTime?       @map("started_at")
  finishedAt DateTime?       @map("finished_at")

  mission  Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([missionId])
  @@index([status])
  @@map("mission_executions")
}

/// Append-only activity timeline. Designed for high write volume and future
/// live streaming (every meaningful event becomes one immutable row).
model MissionActivity {
  id          String       @id @default(cuid())
  missionId   String       @map("mission_id")
  type        ActivityType
  title       String
  description String?
  actorType   ActorType    @default(SYSTEM) @map("actor_type")
  actorId     String?      @map("actor_id")
  actorName   String?      @map("actor_name")
  // Arbitrary structured payload (ids of related entities, diffs, etc.).
  metadata    Json         @default("{}")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([missionId, createdAt])
  @@index([type])
  @@map("mission_activities")
}

// ----------------------------------------------------------------------------
// AI Orchestrator — provider-agnostic execution platform
//
// "Kubernetes for AI workers": providers/models/workers form the registry,
// executions are first-class entities driven through a generic state machine,
// and cost/usage are accounted per execution. No provider SDK is referenced
// here — adapters live behind an interface in the application layer.
// ----------------------------------------------------------------------------

model AiProvider {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  name        String
  type        AiProviderType
  baseUrl     String?        @map("base_url")
  enabled     Boolean        @default(true)
  // Non-secret config (region, org id, auth-credential reference — never keys).
  config      Json           @default("{}")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  models    AiModel[]
  workers   AiWorker[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("ai_providers")
}

model AiModel {
  id              String  @id @default(cuid())
  providerId      String  @map("provider_id")
  name            String // provider model id, e.g. "gpt-4o", "claude-opus-4-8"
  label           String
  contextWindow   Int     @default(8192) @map("context_window")
  maxOutputTokens Int     @default(4096) @map("max_output_tokens")
  inputCostPer1k  Float   @default(0) @map("input_cost_per_1k")
  outputCostPer1k Float   @default(0) @map("output_cost_per_1k")
  enabled         Boolean @default(true)

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  workers  AiWorker[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([providerId, name])
  @@index([providerId])
  @@map("ai_models")
}

model AiCapability {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  kind        AiCapabilityKind
  name        String
  description String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workers   AiWorker[] @relation("WorkerCapabilities")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, kind])
  @@index([workspaceId])
  @@map("ai_capabilities")
}

/// The Worker Registry entry — a configured, schedulable AI worker bound to a
/// provider + model, with health, pricing, concurrency and tuning.
model AiWorker {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  providerId  String         @map("provider_id")
  modelId     String         @map("model_id")
  name        String
  role        String // e.g. "Engineer", "Researcher", "Reviewer"
  description String?
  status      AiWorkerStatus @default(IDLE)
  health      AiWorkerHealth @default(UNKNOWN)

  contextWindow   Int    @default(8192) @map("context_window")
  maxTokens       Int    @default(4096) @map("max_tokens")
  inputCostPer1k  Float  @default(0) @map("input_cost_per_1k")
  outputCostPer1k Float  @default(0) @map("output_cost_per_1k")
  priority        Int    @default(50) // higher wins during scheduling
  concurrency     Int    @default(1) // max parallel executions
  temperature     Float  @default(0.7)
  timeoutMs       Int    @default(60000) @map("timeout_ms")
  maxRetries      Int    @default(2) @map("max_retries")
  version         String @default("1")

  lastSeenAt DateTime? @map("last_seen_at")

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider     AiProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model        AiModel        @relation(fields: [modelId], references: [id], onDelete: Restrict)
  capabilities AiCapability[] @relation("WorkerCapabilities")
  executions   AiExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, health])
  @@map("ai_workers")
}

/// A named, prioritized dispatch queue. Executions reference a queue; future
/// BullMQ workers drain queues respecting `concurrency`.
model AiQueue {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  name        String
  description String?
  status      AiQueueStatus @default(ACTIVE)
  priority    Int           @default(50)
  concurrency Int           @default(4)

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions AiExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("ai_queues")
}

/// A first-class AI execution. The unit the orchestrator schedules, drives
/// through the state machine, and accounts for. Optionally scoped to a
/// mission, task or project.
model AiExecution {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  title       String
  state       AiExecutionState @default(QUEUED)
  priority    Int              @default(50)
  attempt     Int              @default(1)
  maxAttempts Int              @default(3) @map("max_attempts")

  requiresApproval Boolean @default(false) @map("requires_approval")
  confidence       Float? // 0..1, populated from the result for low-confidence flags
  // The original request payload (user request, params, requested capability).
  input            Json    @default("{}")
  error            String?

  // Optional scoping
  missionId     String? @map("mission_id")
  taskId        String? @map("task_id")
  projectId     String? @map("project_id")
  workerId      String? @map("worker_id")
  queueId       String? @map("queue_id")
  requestedById String? @map("requested_by_id")

  // Per-transition timestamps (the audit trail of the state machine).
  queuedAt          DateTime  @default(now()) @map("queued_at")
  preparingAt       DateTime? @map("preparing_at")
  contextBuiltAt    DateTime? @map("context_built_at")
  runningAt         DateTime? @map("running_at")
  waitingApprovalAt DateTime? @map("waiting_approval_at")
  completedAt       DateTime? @map("completed_at")
  failedAt          DateTime? @map("failed_at")
  cancelledAt       DateTime? @map("cancelled_at")
  retryingAt        DateTime? @map("retrying_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mission     Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  worker      AiWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  queue       AiQueue?  @relation(fields: [queueId], references: [id], onDelete: SetNull)
  requestedBy User?     @relation("ExecutionRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  prompts           AiPrompt[]
  result            AiResult?
  cost              AiCost?
  usage             AiUsage?
  events            AiExecutionEvent[]
  logs              AiExecutionLog[]
  artifacts         AiExecutionArtifact[]
  runtimeExecutions RuntimeExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, state])
  @@index([workspaceId, createdAt])
  @@index([missionId])
  @@index([queueId])
  @@index([workerId])
  @@map("ai_executions")
}

/// A versioned prompt assembled for an execution attempt. The structured
/// context package is persisted so every run is fully reproducible.
model AiPrompt {
  id                 String  @id @default(cuid())
  executionId        String  @map("execution_id")
  version            Int     @default(1)
  systemInstructions String? @map("system_instructions")
  userRequest        String? @map("user_request")
  outputFormat       String? @map("output_format")
  constraints        Json    @default("[]")
  // Assembled provider-agnostic message list.
  messages           Json    @default("[]")
  // The structured context package produced by the Context Builder.
  contextPackage     Json    @default("{}") @map("context_package")
  tokensEstimated    Int     @default(0) @map("tokens_estimated")
  hash               String

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([executionId, version])
  @@index([executionId])
  @@map("ai_prompts")
}

model AiResult {
  id           String  @id @default(cuid())
  executionId  String  @unique @map("execution_id")
  content      String?
  structured   Json?
  finishReason String? @map("finish_reason")
  model        String?
  confidence   Float?
  raw          Json    @default("{}")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_results")
}

/// Monetary cost of an execution. `workspaceId` is denormalized so daily spend
/// rolls up without joining executions.
model AiCost {
  id          String @id @default(cuid())
  executionId String @unique @map("execution_id")
  workspaceId String @map("workspace_id")
  inputCost   Float  @default(0) @map("input_cost")
  outputCost  Float  @default(0) @map("output_cost")
  totalCost   Float  @default(0) @map("total_cost")
  currency    String @default("USD")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("ai_costs")
}

/// Token + latency usage for an execution (denormalized workspaceId for rollups).
model AiUsage {
  id           String @id @default(cuid())
  executionId  String @unique @map("execution_id")
  workspaceId  String @map("workspace_id")
  inputTokens  Int    @default(0) @map("input_tokens")
  outputTokens Int    @default(0) @map("output_tokens")
  totalTokens  Int    @default(0) @map("total_tokens")
  latencyMs    Int?   @map("latency_ms")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("ai_usages")
}

/// Append-only execution timeline event.
model AiExecutionEvent {
  id          String               @id @default(cuid())
  executionId String               @map("execution_id")
  type        AiExecutionEventType
  message     String?
  data        Json                 @default("{}")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([executionId, createdAt])
  @@map("ai_execution_events")
}

model AiExecutionLog {
  id          String     @id @default(cuid())
  executionId String     @map("execution_id")
  level       AiLogLevel @default(INFO)
  message     String
  data        Json       @default("{}")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([executionId, createdAt])
  @@map("ai_execution_logs")
}

model AiExecutionArtifact {
  id          String       @id @default(cuid())
  executionId String       @map("execution_id")
  name        String
  type        ArtifactType @default(DOCUMENT)
  url         String?
  content     Json         @default("{}")

  execution AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([executionId])
  @@map("ai_execution_artifacts")
}

// ----------------------------------------------------------------------------
// Runtime Layer — generic remote workers (Claude Code is Runtime #1)
//
// This layer is deliberately mission-agnostic: a Runtime runs generic jobs
// (RuntimeCommand) on a RuntimeHost via a RuntimeSession, streaming logs,
// heartbeats and artifacts back. The only bridge to the rest of RNZ OS is the
// optional `aiExecutionId` on RuntimeExecution — set by the orchestrator, never
// read by the runtime adapter.
// ----------------------------------------------------------------------------

/// A machine RNZ OS can run work on.
model RuntimeHost {
  id           String     @id @default(cuid())
  workspaceId  String     @map("workspace_id")
  name         String // friendly name, e.g. "Andrei's MacBook Pro"
  hostname     String
  os           String // e.g. "macOS 15.1", "Ubuntu 24.04"
  arch         String? // e.g. "arm64", "x86_64"
  cpuCores     Int        @default(1) @map("cpu_cores")
  cpuModel     String?    @map("cpu_model")
  memoryMb     Int        @default(0) @map("memory_mb")
  gpu          String?
  status       HostStatus @default(OFFLINE)
  agentVersion String?    @map("agent_version")
  lastSeenAt   DateTime?  @map("last_seen_at")
  metadata     Json       @default("{}")

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runtimes   Runtime[]
  sessions   RuntimeSession[]
  heartbeats RuntimeHeartbeat[]
  executions RuntimeExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("runtime_hosts")
}

/// A runtime instance registered on a host (e.g. a Claude Code worker).
model Runtime {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  hostId         String        @map("host_id")
  type           RuntimeType
  name           String
  version        String?
  status         RuntimeStatus @default(OFFLINE)
  maxConcurrency Int           @default(1) @map("max_concurrency")
  config         Json          @default("{}")

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host         RuntimeHost         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  capabilities RuntimeCapability[] @relation("RuntimeCapabilities")
  sessions     RuntimeSession[]
  executions   RuntimeExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([hostId])
  @@index([workspaceId, type, status])
  @@map("runtimes")
}

model RuntimeCapability {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  kind        RuntimeCapabilityKind
  name        String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runtimes  Runtime[] @relation("RuntimeCapabilities")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, kind])
  @@index([workspaceId])
  @@map("runtime_capabilities")
}

/// A connection session between RNZ OS and a remote agent. The agent
/// authenticates every callback with `token`.
model RuntimeSession {
  id              String               @id @default(cuid())
  runtimeId       String               @map("runtime_id")
  hostId          String               @map("host_id")
  token           String               @unique
  status          RuntimeSessionStatus @default(CONNECTING)
  startedAt       DateTime             @default(now()) @map("started_at")
  lastHeartbeatAt DateTime?            @map("last_heartbeat_at")
  endedAt         DateTime?            @map("ended_at")
  metadata        Json                 @default("{}")

  runtime    Runtime            @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  host       RuntimeHost        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  executions RuntimeExecution[]

  @@index([runtimeId])
  @@index([status])
  @@map("runtime_sessions")
}

/// A generic job specification — what to run. No mission vocabulary.
model RuntimeCommand {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  name        String
  command     String // e.g. "claude", "bash"
  args        Json    @default("[]") // string[]
  cwd         String?
  env         Json    @default("{}")
  // For AI runtimes (e.g. Claude Code) the prompt to run, provider-agnostic.
  prompt      String?
  timeoutMs   Int     @default(600000) @map("timeout_ms")

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions RuntimeExecution[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("runtime_commands")
}

/// A run of a command on a runtime. The generic job instance.
model RuntimeExecution {
  id            String  @id @default(cuid())
  workspaceId   String  @map("workspace_id")
  commandId     String  @map("command_id")
  runtimeId     String? @map("runtime_id")
  hostId        String? @map("host_id")
  sessionId     String? @map("session_id")
  // The ONLY bridge to orchestration. Set by RNZ OS, ignored by the runtime.
  aiExecutionId String? @map("ai_execution_id")

  status      RuntimeExecutionStatus @default(PENDING)
  exitCode    Int?                   @map("exit_code")
  error       String?
  attempt     Int                    @default(1)
  maxAttempts Int                    @default(1) @map("max_attempts")

  queuedAt        DateTime  @default(now()) @map("queued_at")
  dispatchedAt    DateTime? @map("dispatched_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  cancelRequested Boolean   @default(false) @map("cancel_requested")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  command     RuntimeCommand  @relation(fields: [commandId], references: [id], onDelete: Cascade)
  runtime     Runtime?        @relation(fields: [runtimeId], references: [id], onDelete: SetNull)
  host        RuntimeHost?    @relation(fields: [hostId], references: [id], onDelete: SetNull)
  session     RuntimeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  aiExecution AiExecution?    @relation(fields: [aiExecutionId], references: [id], onDelete: SetNull)

  logs       RuntimeLog[]
  artifacts  RuntimeArtifact[]
  heartbeats RuntimeHeartbeat[]
  terminal   RuntimeTerminal?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([runtimeId])
  @@index([hostId])
  @@index([aiExecutionId])
  @@map("runtime_executions")
}

model RuntimeHeartbeat {
  id          String   @id @default(cuid())
  hostId      String?  @map("host_id")
  executionId String?  @map("execution_id")
  cpuPct      Float?   @map("cpu_pct")
  memMb       Int?     @map("mem_mb")
  message     String?
  createdAt   DateTime @default(now()) @map("created_at")

  host      RuntimeHost?      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  execution RuntimeExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([hostId, createdAt])
  @@index([executionId, createdAt])
  @@map("runtime_heartbeats")
}

/// A file/output the runtime produced. Auto-detected change set.
model RuntimeArtifact {
  id                String                @id @default(cuid())
  executionId       String                @map("execution_id")
  path              String
  change            RuntimeArtifactChange @default(MODIFIED)
  kind              RuntimeArtifactKind   @default(FILE)
  sizeBytes         Int?                  @map("size_bytes")
  url               String?
  content           Json                  @default("{}")
  // Set once copied into the mission's artifact store (orchestration side).
  missionArtifactId String?               @map("mission_artifact_id")

  execution RuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([executionId])
  @@map("runtime_artifacts")
}

model RuntimeLog {
  id          String           @id @default(cuid())
  executionId String           @map("execution_id")
  stream      RuntimeLogStream @default(STDOUT)
  sequence    Int              @default(0)
  content     String
  createdAt   DateTime         @default(now()) @map("created_at")

  execution RuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, sequence])
  @@map("runtime_logs")
}

/// A live terminal attached to a runtime execution (1:1).
model RuntimeTerminal {
  id          String                @id @default(cuid())
  executionId String                @unique @map("execution_id")
  status      RuntimeTerminalStatus @default(OPEN)
  cols        Int                   @default(80)
  rows        Int                   @default(24)
  exitCode    Int?                  @map("exit_code")
  startedAt   DateTime              @default(now()) @map("started_at")
  closedAt    DateTime?             @map("closed_at")

  execution RuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("runtime_terminals")
}

// ----------------------------------------------------------------------------
// NextAuth / Auth.js adapter tables
// ----------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
